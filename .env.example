# Healthcare Data Generator — environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored and will NOT be committed.
#
# This project runs entirely as Microsoft Fabric notebooks (see notebooks/).
# These variables are only needed if you want to open one of the notebooks
# locally (e.g. in VS Code Jupyter) and run cells against a real database
# outside of Fabric — the deployed Fabric notebooks authenticate on their own
# via a non-interactive AAD token and do NOT need any of this.
#
# ── Database Connection (local/manual testing only) ──────────────────
# Provide a **URL-encoded** ODBC connection string.
#
# Example — Azure SQL / Fabric SQL with Azure AD Interactive auth:
#   CONNECTION_STRING=Driver%3D%7BODBC+Driver+18+for+SQL+Server%7D%3BServer%3Dyour-server.database.fabric.microsoft.com%2C1433%3BDatabase%3Dyour-database%3BEncrypt%3Dyes%3BTrustServerCertificate%3Dno%3BAuthentication%3DActiveDirectoryInteractive
#
# Tip: URL-encode a raw ODBC string with Python:
#   python -c "import urllib.parse; print(urllib.parse.quote_plus('Driver={ODBC Driver 18 for SQL Server};Server=...'))"
CONNECTION_STRING=

# ── Notebook tuning knobs (optional, all have sane defaults) ──────────
# PATIENT_LOAD_MULTIPLIER=4.0
# HOSPITAL_BED_SCALE=0.35
# MAX_CATCHUP_DAYS=0
# DEFAULT_HISTORY_START_DATE=2025-01-01
# FABRIC_SERVER=your-workspace.database.fabric.microsoft.com
# FABRIC_DB=your-database-name

